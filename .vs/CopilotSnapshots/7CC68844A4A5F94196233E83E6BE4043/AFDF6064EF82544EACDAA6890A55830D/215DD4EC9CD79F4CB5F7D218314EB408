using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using GestorPrestaciones;

namespace GestorPrestacionesWeb.Pages.Clientes
{
    public class CreateModel : PageModel
    {
        private readonly ServiciosCliente _servicios;
        private readonly ServiciosTrabajo _serviciosTrabajo;
        private readonly ServiciosIntervalos _serviciosIntervalos;

        [BindProperty]
        public Cliente Cliente { get; set; }

        public List<Trabajo> TrabajoOptions { get; set; }

        public CreateModel(ServiciosCliente servicios, ServiciosTrabajo serviciosTrabajo)
        {
            _servicios = servicios;
            _serviciosTrabajo = serviciosTrabajo;
        }

        public async Task OnGetAsync()
        {
            Cliente = new Cliente();
            TrabajoOptions = await _serviciosTrabajo.ListaTrabajos();
        }

        public async Task<IActionResult> OnPostAsync()
        {
            if (!ModelState.IsValid)
                return Page();

            // Parse trabajos dinámicos
            var trabajos = new List<IntervaloTrabajo>();
            for (int i = 0; ; i++)
            {
                var keySelect = $"trabajo_select_{i}";
                if (!Request.Form.ContainsKey(keySelect))
                    break;

                var seleccion = Request.Form[keySelect].ToString();
                var keyInicio = $"trabajo_inicio_{i}";
                var keyFin = $"trabajo_fin_{i}";

                // Parsear fechas
                var intervaloFecha = new IntervaloFecha();
                if (Request.Form.ContainsKey(keyInicio) && DateOnly.TryParse(Request.Form[keyInicio], out var fechaInicio))
                    intervaloFecha.Inicio = fechaInicio;

                if (Request.Form.ContainsKey(keyFin) && DateOnly.TryParse(Request.Form[keyFin], out var fechaFin))
                    intervaloFecha.Fin = fechaFin;

                var intervaloTrabajo = new IntervaloTrabajo 
                { 
                    Intervalo = intervaloFecha 
                };

                // Determinar si es trabajo existente o nuevo
                if (!string.IsNullOrEmpty(seleccion) && seleccion != "0" && int.TryParse(seleccion, out var trabajoId) && trabajoId > 0)
                {
                    // Usar trabajo existente
                    intervaloTrabajo.Trabajo = new Trabajo { Id = trabajoId };
                }
                else
                {
                    // Crear nuevo trabajo
                    var keyNombre = $"trabajo_new_nombre_{i}";
                    var keyRiesgo = $"trabajo_new_risk_{i}";

                    var nombre = Request.Form.ContainsKey(keyNombre) ? Request.Form[keyNombre].ToString() : string.Empty;
                    var esDeRiesgo = Request.Form.ContainsKey(keyRiesgo) && Request.Form[keyRiesgo] == "on";

                    intervaloTrabajo.Trabajo = new Trabajo 
                    { 
                        Nombre = nombre, 
                        EsDeRiesgo = esDeRiesgo 
                    };
                }

                trabajos.Add(intervaloTrabajo);
            }

            // Parse bajas dinámicas
            var bajas = new List<IntervaloBaja>();
            for (int i = 0; ; i++)
            {
                var keyInicio = $"baja_inicio_{i}";
                if (!Request.Form.ContainsKey(keyInicio))
                    break;

                var keyFin = $"baja_fin_{i}";

                // Parsear fechas
                var intervaloFecha = new IntervaloFecha();
                if (Request.Form.ContainsKey(keyInicio) && DateOnly.TryParse(Request.Form[keyInicio], out var fechaInicio))
                    intervaloFecha.Inicio = fechaInicio;

                if (Request.Form.ContainsKey(keyFin) && DateOnly.TryParse(Request.Form[keyFin], out var fechaFin))
                    intervaloFecha.Fin = fechaFin;

                var intervaloBaja = new IntervaloBaja 
                { 
                    IntervaloFecha = intervaloFecha,
                    Tipo = IntervaloBaja.TipoBaja.noseque
                };

                bajas.Add(intervaloBaja);
            }

            // Crear el cliente con todos sus datos relacionados
            await _servicios.CrearClienteCompleto(Cliente, trabajos, bajas);

            return RedirectToPage("Index");
        }
    }
}
